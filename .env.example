# Login. Defaults to Heychic / Heychic8888 when unset.
STORE_USERNAME=Heychic
STORE_PASSWORD=Heychic8888

# Required. Non-empty signing secret, separate from login passwords.
ADMIN_SECRET=

# Name shown on the player
NEXT_PUBLIC_STORE_NAME=Store Music

# Set automatically when a Vercel Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=

# Separate administrator account. Required to manage the library.
ADMIN_USERNAME=
ADMIN_PASSWORD=
